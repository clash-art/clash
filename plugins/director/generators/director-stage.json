{
  "apiVersion": "clash.generator/v1",
  "kind": "generator",
  "spec": {
    "definitionId": "director-stage",
    "stateSchema": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "owner": { "type": "object" },
            "state": { "type": "object" }
          },
          "required": ["name", "owner", "state"],
          "additionalProperties": false
        }
      },
      "required": ["stage"],
      "additionalProperties": false
    },
    "editPolicy": "advance-head",
    "persistentInputs": [{
      "slot": "stage:code",
      "accepts": [{ "kind": "document", "documentKind": "text.plain", "schemaVersion": 1 }],
      "cardinality": { "minItems": 0, "maxItems": null }
    }, {
      "slot": "stage:media",
      "accepts": [{ "kind": "media", "mediaKind": "image" }, { "kind": "media", "mediaKind": "video" }, { "kind": "media", "mediaKind": "model" }],
      "cardinality": { "minItems": 0, "maxItems": null }
    }],
    "actions": [{
      "id": "capture-frame",
      "executorExportId": "capture-frame",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "timeSeconds": { "type": "number", "minimum": 0 },
          "aspectRatio": { "enum": ["16:9", "9:16", "4:3", "3:4", "1:1"] },
          "longEdge": { "type": "integer", "minimum": 256, "maximum": 4096 }
        },
        "required": ["label", "timeSeconds", "aspectRatio", "longEdge"],
        "additionalProperties": false
      },
      "invocationInputs": [],
      "outputs": [{ "slot": "frame", "assetType": { "kind": "media", "mediaKind": "image" }, "cardinality": { "minItems": 1, "maxItems": 1 } }]
    }],
    "projectionSurface": { "id": "clash.director-stage", "stateKey": "stage", "mediaInputSlot": "stage:media", "primaryActionId": "capture-frame" }
  }
}
