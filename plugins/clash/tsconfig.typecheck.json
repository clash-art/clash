{
  "extends": "./tsconfig.dev.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./.cache/typecheck.tsbuildinfo",
    "declaration": false
  },
  "include": ["src/**/*.ts", "scripts/pack-distribution.ts"]
}
