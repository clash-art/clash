      {
        "id": "minimax-tts",
        "kind": "model-provider-binding",
        "path": "bindings/minimax-tts.json"
      },
      {
        "id": "minimax-music-3",
        "kind": "model-provider-binding",
        "path": "bindings/minimax-music-3.json"
      },
      {
        "id": "minimax-h3",
        "kind": "model-provider-binding",
        "path": "bindings/minimax-h3.json"
      },
      {
        "id": "minimax-h3-startend",
        "kind": "model-provider-binding",
        "path": "bindings/minimax-h3-startend.json"
      },
      {
        "id": "gpt-image-2.5-flare",
        "kind": "model-provider-binding",
        "path": "bindings/gpt-image-2.5-flare.json"
