{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.fal",
  "version": "0.2.0",
  "name": "fal.ai",
  "description": "fal.ai queued generation, including Hunyuan3D model generation.",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "cards": [],
    "functions": [
      {
        "id": "fal-execute",
        "kind": "provider-executor",
        "operations": [
          "submit",
          "poll"
        ]
      }
    ],
    "providers": [
      {
        "id": "fal",
        "kind": "provider",
        "path": "providers/fal.json"
      }
    ],
    "modelBindings": [
      {
        "id": "flux-schnell",
        "kind": "model-provider-binding",
        "path": "bindings/flux-schnell.json"
      },
      {
        "id": "flux-dev",
        "kind": "model-provider-binding",
        "path": "bindings/flux-dev.json"
      },
      {
        "id": "gpt-image-2",
        "kind": "model-provider-binding",
        "path": "bindings/gpt-image-2.json"
      },
      {
        "id": "nano-banana-2",
        "kind": "model-provider-binding",
        "path": "bindings/nano-banana-2.json"
      },
      {
        "id": "seedream-4.5",
        "kind": "model-provider-binding",
        "path": "bindings/seedream-4.5.json"
      },
      {
        "id": "recraft-v4",
        "kind": "model-provider-binding",
        "path": "bindings/recraft-v4.json"
      },
      {
        "id": "flux-2-pro",
        "kind": "model-provider-binding",
        "path": "bindings/flux-2-pro.json"
      },
      {
        "id": "sora-2",
        "kind": "model-provider-binding",
        "path": "bindings/sora-2.json"
      },
      {
        "id": "kling-3",
        "kind": "model-provider-binding",
        "path": "bindings/kling-3.json"
      },
      {
        "id": "flux-3-video",
        "kind": "model-provider-binding",
        "path": "bindings/flux-3-video.json"
      },
      {
        "id": "flux-3-video-keyframes",
        "kind": "model-provider-binding",
        "path": "bindings/flux-3-video-keyframes.json"
      },
      {
        "id": "flux-3-video-continue",
        "kind": "model-provider-binding",
        "path": "bindings/flux-3-video-continue.json"
      },
      {
        "id": "seedance-2-startend",
        "kind": "model-provider-binding",
        "path": "bindings/seedance-2-startend.json"
      },
      {
        "id": "seedance-2-ref",
        "kind": "model-provider-binding",
        "path": "bindings/seedance-2-ref.json"
