{
  "apiVersion": "clash.generator/v1",
  "kind": "generator",
  "spec": {
    "definitionId": "media-analysis",
    "stateSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "editPolicy": "advance-head",
    "persistentInputs": [],
    "actions": [
      {
        "id": "analyze",
        "executorExportId": "analyze",
        "selectOutputsByParameter": "categories",
        "modelConsumer": {
          "semanticShape": "media_analysis",
          "sourceInputSlot": "source"
        },
        "parametersSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "description": "Analyze the source using this question or instruction and return a free-form answer. Omit categories."
            },
            "categories": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "uniqueItems": true,
              "default": ["description"]
            }
          },
          "oneOf": [
            { "properties": { "prompt": {} }, "required": ["prompt"] },
            { "properties": { "categories": {} }, "required": ["categories"] }
          ],
          "additionalProperties": false
        },
        "invocationInputs": [
          {
            "slot": "source",
            "accepts": [
              { "kind": "media", "mediaKind": "image" },
              { "kind": "media", "mediaKind": "video" },
              { "kind": "media", "mediaKind": "audio" }
            ],
            "cardinality": { "minItems": 1, "maxItems": 1 }
          }
        ],
        "outputs": [
          {
            "slot": "description",
            "title": "Semantic description",
            "sourceMediaKinds": ["image", "video", "audio"],
            "prompt": "Return a concise semantic description as JSON with a non-empty text field.",
            "promptParameter": "prompt",
            "promptVersion": "media-analysis/v1",
            "assetType": { "kind": "document", "documentKind": "media.analysis.description", "schemaVersion": 1 },
            "cardinality": { "minItems": 0, "maxItems": 1 }
          },
          {
            "slot": "tags",
            "title": "Tags",
            "sourceMediaKinds": ["image", "video", "audio"],
            "prompt": "Return semantic tags as JSON with a tags string array.",
            "promptVersion": "media-analysis/v1",
            "assetType": { "kind": "document", "documentKind": "media.analysis.tags", "schemaVersion": 1 },
            "cardinality": { "minItems": 0, "maxItems": 1 }
          },
          {
            "slot": "subjects",
            "title": "Subjects, people, and objects",
            "sourceMediaKinds": ["image", "video"],
            "prompt": "Return visible subjects, people, and objects as JSON items with type and name.",
            "promptVersion": "media-analysis/v1",
            "assetType": { "kind": "document", "documentKind": "media.analysis.subjects", "schemaVersion": 1 },
            "cardinality": { "minItems": 0, "maxItems": 1 }
          },
          {
            "slot": "actions-events",
            "title": "Actions and events",
            "sourceMediaKinds": ["image", "video", "audio"],
            "prompt": "Return actions and events as JSON items with a label and optional timing.",
            "promptVersion": "media-analysis/v1",
            "assetType": { "kind": "document", "documentKind": "media.analysis.actions-events", "schemaVersion": 1 },
            "cardinality": { "minItems": 0, "maxItems": 1 }
          },
          {
            "slot": "scene-shot",
            "title": "Scenes and shots",
            "sourceMediaKinds": ["image", "video"],
            "prompt": "Return scenes and camera shots as JSON scenes with descriptions and optional timing.",
            "promptVersion": "media-analysis/v1",
            "assetType": { "kind": "document", "documentKind": "media.analysis.scene-shot", "schemaVersion": 1 },
            "cardinality": { "minItems": 0, "maxItems": 1 }
          },
          {
            "slot": "style",
            "title": "Style, mood, and composition",
            "sourceMediaKinds": ["image", "video"],
            "prompt": "Return visual style, mood, and composition as JSON with a summary.",
            "promptVersion": "media-analysis/v1",
            "assetType": { "kind": "document", "documentKind": "media.analysis.style", "schemaVersion": 1 },
            "cardinality": { "minItems": 0, "maxItems": 1 }
          },
          {
            "slot": "ocr",
            "title": "On-screen text OCR",
            "sourceMediaKinds": ["image", "video"],
            "prompt": "Return visible on-screen text as JSON items. Do not create an audio transcript.",
            "promptVersion": "media-analysis/v1",
            "assetType": { "kind": "document", "documentKind": "media.analysis.ocr", "schemaVersion": 1 },
            "cardinality": { "minItems": 0, "maxItems": 1 }
          },
          {
            "slot": "audio-semantics",
            "title": "Audio semantics",
            "sourceMediaKinds": ["video", "audio"],
            "prompt": "Return semantic audio content, speech summary, music, and sounds as JSON with a summary. Do not return a verbatim transcript.",
            "promptVersion": "media-analysis/v1",
            "assetType": { "kind": "document", "documentKind": "media.analysis.audio-semantics", "schemaVersion": 1 },
            "cardinality": { "minItems": 0, "maxItems": 1 }
          }
        ]
      }
    ]
  }
}
