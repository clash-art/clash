{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.media-analysis",
  "version": "0.1.0",
  "name": "Clash Media Analysis",
  "description": "Analyze an image, video, or audio Asset using a custom prompt, or select structured analysis categories.",
  "author": "Clash",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "cards": [],
    "generators": [
      {
        "id": "media-analysis",
        "kind": "generator",
        "path": "generators/media-analysis.json"
      }
    ],
    "functions": [
      {
        "id": "analyze",
        "kind": "action",
        "operations": ["submit"]
      }
    ],
    "hostTools": ["media.analyze"]
  },
  "contractTests": []
}
