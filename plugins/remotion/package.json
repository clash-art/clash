{
  "name": "@clash-plugin/remotion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    "./manifest.json": "./manifest.json",
    "./stdio": "./dist/stdio.mjs"
  },
  "files": [
    "manifest.json",
    "dist",
    "agents.json"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/copy-browser-bundle.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.check.json"
  },
  "dependencies": {
    "@clash/action-sdk": "workspace:*",
    "@clash/shared-types": "workspace:*",
    "@remotion/renderer": "4.0.507"
  },
  "devDependencies": {
    "@clash/render-server": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
