                ],
                "message": "Shared Project Host modules are platform-agnostic: storage, DB, blob, realtime, clock, ids and auth arrive through injected ports; only api-cf / api-node / local-api composition roots know the platform."
              },
              {
                "group": [
                  "pg",
                  "pg/*",
                  "postgres",
                  "@electric-sql/*",
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "better-sqlite3",
                  "kysely"
                ],
                "message": "Shared Project Host modules are platform-agnostic: storage, DB, blob, realtime, clock, ids and auth arrive through injected ports; only api-cf / api-node / local-api composition roots know the platform."
              },
              {
                "group": [
                  "hono",
                  "hono/*",
                  "better-auth",
                  "better-auth/*"
                ],
                "message": "Shared Project Host modules are command-in / JSON-out; HTTP and auth shells live in the adapters."
              },
              {
                "group": [
                  "**/apps/*",
                  "**/apps/**",
                  "@clash/local-api*",
                  "@clash/api-node*",
                  "@clash/api-cf*",
                  "@clash/desktop*",
                  "@clash/web",
                  "@clash/web/*"
                ],
                "message": "Shared Project Host modules are platform-agnostic: storage, DB, blob, realtime, clock, ids and auth arrive through injected ports; only api-cf / api-node / local-api composition roots know the platform."
              },
              {
