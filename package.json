{
  "name": "@clash/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Where agents co-create, humans are welcome too.",
  "scripts": {
    "dev": "turbo run dev --filter=@clash/web --filter=@clash/render-server",
    "dev:log": "./scripts/dev-log.sh",
    "clash:dev": "CLASH_SOURCE_RUNTIME=1 pnpm --filter clash exec tsx --tsconfig tsconfig.dev.json src/dispatcher.ts --profile dev",
    "clash:prod": "node plugins/clash/runtime/dispatcher.js --profile prod",
    "mcp:dev": "CLASH_SOURCE_RUNTIME=1 pnpm --filter clash exec tsx --tsconfig tsconfig.dev.json src/dispatcher.ts --profile dev mcp",
    "logs": "./scripts/logs.sh",
    "build": "turbo run build",
    "build:package": "turbo run build --filter",
    "dev:package": "turbo run dev --filter",
    "start:desktop": "pnpm build:package @clash/desktop && pnpm --filter @clash/desktop start",
    "prepare:desktop-pack": "turbo run build --filter=\"@clash-plugin/*\" && turbo run build --filter=clash --filter=@clash/desktop && pnpm --filter @clash/cli bundle:agents && pnpm --filter @clash/desktop prepare:pack",
    "pack:desktop:dir": "pnpm --filter @clash/desktop pack:dir",
    "pack:desktop:dmg": "pnpm --filter @clash/desktop pack:dmg",
    "pack:desktop:mac": "pnpm pack:desktop:mac:arm64",
    "pack:desktop:mac:arm64": "pnpm --filter @clash/desktop pack:mac:arm64",
    "pack:desktop:mac:x64": "pnpm --filter @clash/desktop pack:mac:x64",
    "pack:desktop:mac:universal": "pnpm --filter @clash/desktop pack:mac:universal",
    "pack:desktop:win": "pnpm --filter @clash/desktop pack:win",
    "pack:desktop:linux": "pnpm --filter @clash/desktop pack:linux",
    "test": "turbo run test",
    "test:package": "turbo run test --filter",
    "test:e2e": "turbo run test:e2e --filter=@clash/local-api --filter=@clash/web --filter=@clash/desktop",
    "test:e2e:qa-agent": "pnpm build:package @clash/desktop && pnpm --filter @clash/desktop test:e2e:qa-agent",
    "test:e2e:agent-first-local-v1": "pnpm build:package @clash/desktop && pnpm --filter @clash/desktop test:e2e:agent-first-local-v1",
    "test:e2e:short-drama-timeline": "pnpm build:package @clash/desktop && pnpm --filter @clash/desktop test:e2e:short-drama-timeline",
    "test:e2e:agent-first-cas": "pnpm build:package @clash/desktop && pnpm --filter @clash/desktop test:e2e:agent-first-cas",
    "test:skills": "node --test skills/skill-market.test.ts",
    "test:agent:real-codex": "pnpm build:package @clash/desktop && pnpm --filter @clash/desktop test:agent:real-codex",
    "test:startup": "turbo run build --filter=@clash/web --filter=@clash/desktop && pnpm test:startup:api && pnpm --filter @clash/desktop test:startup",
    "test:startup:api": "pnpm --filter @clash/local-api test:e2e",
    "test:startup:harness-update-gui": "turbo run build --filter=@clash/web --filter=@clash/desktop && pnpm --filter @clash/desktop test:startup:harness-update-gui",
    "test:startup:real-codex-cold": "pnpm build:package @clash/desktop && pnpm --filter @clash/desktop test:startup:real-codex-cold",
    "test:startup:real-codex": "pnpm build:package @clash/desktop && pnpm --filter @clash/desktop test:startup:real-codex",
    "test:startup:real-codex-resume": "pnpm build:package @clash/desktop && pnpm --filter @clash/desktop test:startup:real-codex-resume",
    "benchmark:artifacts": "pnpm --dir packages/shared-artifact-evals exec tsx src/cli.ts",
    "benchmark:agent-product": "pnpm --dir packages/shared-artifact-evals exec tsx src/cli.ts --suite benchmarks/agent-product/v1/suite.json",
    "assets:director:anny": "tsx scripts/generate-director-anny-assets.ts",
    "lint": "turbo run lint",
    "lint:package": "turbo run lint --filter",
    "typecheck": "turbo run typecheck",
    "typecheck:package": "turbo run typecheck --filter",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "keywords": [
    "creative-platform",
    "agent-platform",
    "ai-video-editor",
    "agent-native",
    "ai-agents",
    "generative-ai",
    "video-production",
    "video-editor",
    "timeline",
    "mcp",
    "codex",
    "electron",
    "remotion",
    "self-hosted",
    "crdt",
    "cloudflare",
    "react"
  ],
  "author": "hrhrng <hrhrng@foxmail.com>",
  "license": "PolyForm-Shield-1.0.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "wrangler": "^4"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "react": "19.2.5",
      "react-dom": "19.2.5",
      "remotion": "4.0.507",
      "@remotion/*": "4.0.507",
      "@vitest/utils": "4.1.0",
      "@vitest/runner": "4.1.0",
      "@vitest/snapshot": "4.1.0",
      "@vitest/expect": "4.1.0",
      "@vitest/spy": "4.1.0",
      "@vitest/pretty-format": "4.1.0",
      "@vitest/mocker": "4.1.0",
      "vitest": "4.1.0",
      "@electron/get": "5.0.0"
    },
    "patchedDependencies": {
      "@openma/common@0.5.0": "patches/@openma__common@0.5.0.patch"
    }
  },
  "dependencies": {
    "@cloudflare/containers": "^0.2.0",
    "@openma/common": "link:../openma-common",
    "better-auth": "^1.4.6",
    "better-auth-cloudflare": "^0.2.9",
    "zod": "^4"
  }
}
