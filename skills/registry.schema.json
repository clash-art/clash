{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clash.local/schemas/skill-marketplace-registry.schema.json",
  "title": "Clash skill marketplace registry",
  "type": "object",
  "required": [
    "version",
    "marketplaceSemantics",
    "skills",
    "systemCapabilities",
    "thirdPartyReferences"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "marketplaceSemantics": {
      "type": "object",
      "required": [
        "skillBoundary",
        "executionModel",
        "hostCapabilityContract",
        "artifactContract",
        "systemCapabilityMeaning",
        "statusPolicy",
        "clashRole"
      ],
      "properties": {
        "skillBoundary": { "const": "portable-artifact-contract" },
        "executionModel": {
          "type": "object",
          "required": [
            "portableSkillExecution",
            "clashManagedExecution",
            "hardBoundary"
          ],
          "properties": {
            "portableSkillExecution": { "type": "string" },
            "clashManagedExecution": { "type": "string" },
            "hardBoundary": { "type": "string" }
          }
        },
        "hostCapabilityContract": { "type": "string" },
        "artifactContract": {
          "type": "object",
          "required": [
            "publicInterfaces",
            "skillOwnedWorkspace",
            "hostOwnedInternals",
            "forbiddenDependencyPolicy"
          ],
          "properties": {
            "publicInterfaces": {
              "type": "array",
              "items": {
                "enum": [
                  "action",
                  "metadata-fill",
                  "asset",
                  "analysis-metadata",
                  "view-projection",
                  "timeline-cas-apply",
                  "schema"
                ]
              }
            },
            "skillOwnedWorkspace": { "type": "string" },
            "hostOwnedInternals": {
              "type": "array",
              "items": {
                "enum": [
                  "snapshot.bin",
                  "project.sqlite",
                  "loro-crdt-doc",
                  "canvas-private-node-state",
                  "runtime-secrets"
                ]
              }
            },
            "forbiddenDependencyPolicy": { "type": "string" }
          }
        },
        "systemCapabilityMeaning": { "type": "string" },
        "statusPolicy": {
          "type": "object",
          "required": ["ready", "blockedBySystemGap"],
          "properties": {
            "ready": { "type": "string" },
            "blockedBySystemGap": { "type": "string" }
          }
        },
        "clashRole": {
          "type": "array",
          "items": {
            "enum": [
              "collaboration-management",
              "asset-registry",
              "metadata-fill",
              "provenance",
              "review-gates",
              "timeline-cas-apply",
              "canvas-timeline-projection"
            ]
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "Executable first-party action contracts that bind portable skills to local host commands and artifact outputs.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source",
          "skillId",
          "trigger",
          "lifecycle",
          "inputs",
          "outputs",
          "contractTests",
          "requiredSystemCapabilities"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^clash\\.action\\." },
          "title": { "type": "string" },
          "source": { "const": "first-party" },
          "skillId": { "type": "string", "pattern": "^clash\\." },
          "trigger": {
            "type": "object",
            "required": ["mode", "command", "requiresLocalRuntime"],
            "properties": {
              "mode": { "const": "local-cli" },
              "command": { "type": "string", "pattern": "^clash " },
              "requiresLocalRuntime": { "const": true }
            }
          },
          "lifecycle": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "action",
                "metadata-fill",
                "asset",
                "view-projection",
                "review-gate"
              ]
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "pathPattern"],
              "properties": {
                "kind": {
                  "enum": [
                    "action",
                    "asset",
                    "metadata",
                    "projection",
                    "view",
                    "analysis",
                    "manifest",
                    "source"
                  ]
                },
                "pathPattern": { "type": "string" },
                "schema": { "type": "string" }
              }
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "pathPattern"],
              "properties": {
                "kind": {
                  "enum": [
                    "action",
                    "asset",
                    "metadata",
                    "projection",
                    "view",
                    "analysis",
                    "manifest",
                    "review-gate",
                    "export"
                  ]
                },
                "pathPattern": { "type": "string" },
                "schema": { "type": "string" },
                "metadataKind": { "type": "string" },
                "metadataSchema": { "type": "string" },
                "casRequired": { "type": "boolean" },
                "applyCommand": {
                  "enum": [
                    "clash assets metadata apply",
                    "clash timeline apply"
                  ]
                },
                "timelineIdPlaceholder": { "const": "<timeline-id>" },
                "requiredRuntimeArgs": {
                  "type": "array",
                  "items": { "type": "string" },
                  "contains": { "const": "--timeline <timeline-id>" }
                },
                "pullCommand": { "const": "clash timeline pull" },
                "pullArgsPattern": {
                  "type": "array",
                  "prefixItems": [
                    { "const": "--timeline" },
                    { "const": "<timeline-id>" },
                    { "const": "--file" },
                    { "const": "timelines/main.timeline.yaml" }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                },
                "applyArgsPattern": {
                  "type": "array",
                  "prefixItems": [
                    { "const": "--timeline" },
                    { "const": "<timeline-id>" },
                    { "const": "--file" },
                    { "type": "string" }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": { "const": "projection" }
                    },
                    "required": ["kind"]
                  },
                  "then": {
                    "required": [
                      "casRequired",
                      "applyCommand",
                      "timelineIdPlaceholder",
                      "requiredRuntimeArgs",
                      "pullCommand",
                      "pullArgsPattern",
                      "applyArgsPattern"
                    ],
                    "properties": {
                      "casRequired": { "const": true },
                      "applyCommand": { "const": "clash timeline apply" },
                      "timelineIdPlaceholder": { "const": "<timeline-id>" },
                      "requiredRuntimeArgs": {
                        "contains": { "const": "--timeline <timeline-id>" }
                      },
                      "pullCommand": { "const": "clash timeline pull" }
                    }
                  }
                }
              ]
            }
          },
          "contractTests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "asserts"],
              "properties": {
                "path": { "type": "string" },
                "asserts": { "type": "string" }
              }
            }
          },
          "requiredSystemCapabilities": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "title",
          "description",
          "kind",
          "source",
          "tags",
          "requiredSystemCapabilities"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^clash\\." },
          "name": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "type": { "const": "skill" },
          "kind": { "enum": ["architecture", "detail"] },
          "source": {
            "enum": ["first-party", "provider-official", "community"]
          },
          "author": { "type": "string" },
          "repository": { "type": "string", "format": "uri" },
          "curation": {
            "type": "object",
            "required": ["collection", "curator"],
            "properties": {
              "collection": { "const": "official-picks" },
              "curator": { "type": "string" }
            },
            "additionalProperties": false
          },
          "attribution": {
            "type": "object",
            "required": ["sourceUrl"],
            "properties": {
              "sourceUrl": { "type": "string", "format": "uri" },
              "license": { "type": "string" },
              "licenseUrl": { "type": "string", "format": "uri" },
              "repositoryStars": { "type": "integer", "minimum": 0 },
              "checkedAt": { "type": "string", "format": "date" },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          },
          "sourceVersion": { "type": "string" },
          "path": { "type": "string" },
          "cover": {
            "type": "object",
            "required": ["src"],
            "properties": {
              "src": { "type": "string", "format": "uri" },
              "alt": { "type": "string" }
            },
            "additionalProperties": false
          },
          "install": {
            "type": "object",
            "required": ["kind", "skill", "scope"],
            "properties": {
              "kind": { "enum": ["npx-skills", "bundled-skill"] },
              "source": { "type": "string", "pattern": "^https://" },
              "skill": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "scope": { "const": "global" }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "npx-skills" } } },
                "then": { "required": ["source"] },
                "else": { "not": { "required": ["source"] } }
              }
            ]
          },
          "tags": { "type": "array", "items": { "type": "string" } },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "executionContract": {
            "enum": ["production-action", "native-cli-mcp", "prompt-compiler"],
            "description": "How the ready skill reaches executable product behavior. Native CLI/MCP contracts do not require a synthetic production action wrapper."
          },
          "requiredSystemCapabilities": {
            "type": "array",
            "description": "Compatibility names for host capabilities needed to make the skill runnable as a managed production workflow.",
            "items": { "type": "string" }
          },
          "systemGaps": {
            "type": "array",
            "description": "Explicit Clash-managed execution gaps for skills marked blocked-by-system-gap.",
            "items": {
              "type": "object",
              "required": ["capability", "gap", "unblockSignal"],
              "properties": {
                "capability": { "type": "string" },
                "gap": { "type": "string" },
                "unblockSignal": { "type": "string" }
              }
            }
          },
          "researchSources": { "type": "array", "items": { "type": "string" } },
          "status": {
            "enum": ["draft", "ready", "blocked-by-system-gap"],
            "description": "ready means local runnable action/contract coverage exists; blocked-by-system-gap means concrete host capabilities are still missing."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": { "const": "first-party" }
              },
              "required": ["source"]
            },
            "then": {
              "required": ["path"]
            }
          },
          {
            "if": {
              "properties": {
                "source": { "enum": ["provider-official", "community"] }
              },
              "required": ["source"]
            },
            "then": {
              "required": ["sourceVersion", "install", "executionContract"]
            }
          },
          {
            "if": {
              "required": ["install"],
              "properties": {
                "install": {
                  "properties": { "kind": { "const": "bundled-skill" } }
                }
              }
            },
            "then": {
              "required": ["path"]
            }
          },
          {
            "if": {
              "required": ["curation"],
              "properties": {
                "source": { "enum": ["provider-official", "community"] }
              }
            },
            "then": {
              "required": ["author", "repository", "attribution"],
              "properties": {
                "attribution": {
                  "required": ["license", "licenseUrl", "checkedAt"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": { "const": "blocked-by-system-gap" }
              },
              "required": ["status"]
            },
            "then": {
              "required": ["systemGaps"],
              "properties": {
                "systemGaps": { "minItems": 1 }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": { "const": "ready" }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "systemGaps": { "maxItems": 0 }
              }
            }
          }
        ]
      }
    },
    "thirdPartyReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "license",
          "licenseSource",
          "usage",
          "integrationPolicy"
        ],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "license": { "type": "string" },
          "licenseSource": { "type": "string" },
          "usage": {
            "enum": [
              "research-only",
              "reference-or-integration-with-notice",
              "user-installed-tool",
              "existing-runtime-with-license-check"
            ]
          },
          "integrationPolicy": { "type": "string" }
        }
      }
    },
    "systemCapabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["available", "partial", "missing"] },
          "description": { "type": "string" }
        }
      }
    }
  }
}
