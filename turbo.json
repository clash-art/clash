{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "tsconfig.source.json",
    "source-check-profiles.json",
    "scripts/source-check-config.ts",
    "tsconfig.quality.json",
    ".eslintrc.*",
    "scripts/package.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".remotion-bundle/**",
        "dist/**",
        "runtime/**"
      ],
      "outputLogs": "new-only"
    },
    "clash#build": {
      "dependsOn": [
        "^build",
        "@clash/web#build"
      ],
      "outputs": [
        "runtime/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^test",
        "build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.jsonl",
        "src/**/*.png",
        "src/**/*.jpg",
        "src/**/*.wav",
        "src/**/*.mp3",
        "src/**/*.mp4",
        "test/**/*.ts",
        "test/**/*.tsx",
        "test/**/*.jsonl",
        "app/**/*.ts",
        "app/**/*.tsx",
        "lib/**/*.ts",
        "lib/**/*.tsx",
        "scripts/**/*.ts",
        "vitest.config.*",
        "vitest.setup.*",
        "package.json"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "outputs": []
    },
    "lint": {
      "outputs": [],
      "dependsOn": [
        "typecheck",
        "^typecheck"
      ]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": [
        "^typecheck"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
