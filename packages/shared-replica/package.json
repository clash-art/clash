{
  "name": "@clash/replica",
  "version": "0.1.0",
  "private": true,
  "description": "Portable durable replica engine and Loro protocol adapters",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./loro": {
      "types": "./src/loro.ts",
      "import": "./src/loro.ts",
      "default": "./dist/loro.js"
    },
    "./loro-protocol": {
      "types": "./src/loro-protocol.ts",
      "import": "./src/loro-protocol.ts",
      "default": "./dist/loro-protocol.js"
    },
    "./replica-relay": {
      "types": "./src/replica-relay.ts",
      "import": "./src/replica-relay.ts",
      "default": "./dist/replica-relay.js"
    },
    "./replica-stream-client": {
      "types": "./src/replica-stream-client.ts",
      "import": "./src/replica-stream-client.ts",
      "default": "./dist/replica-stream-client.js"
    },
    "./loro-stream-session": {
      "types": "./src/loro-stream-session.ts",
      "import": "./src/loro-stream-session.ts",
      "default": "./dist/loro-stream-session.js"
    }
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.check.json"
  },
  "dependencies": {
    "@loro-dev/streams-client": "0.7.0",
    "loro-crdt": "1.16.3",
    "loro-protocol": "^0.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
