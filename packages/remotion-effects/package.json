{
  "name": "@clash/remotion-effects",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "description": "Versioned effect SDK and render-graph compiler for Clash",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./authoring": "./src/authoring.ts",
    "./builtins": "./src/builtins.ts",
    "./shader-effects": "./src/shader-effects.ts",
    "./webgl": "./src/webgl.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.3.1"
  }
}
