{
  "name": "@clash/shared-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Clash MCP server and wire-schema compatibility boundary",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generator-tools": {
      "types": "./dist/generator-tools.d.ts",
      "import": "./dist/generator-tools.js",
      "default": "./dist/generator-tools.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit --project tsconfig.check.json"
  },
  "dependencies": {
    "@clash/shared-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "license": "MIT",
  "files": [
    "README.md",
    "dist",
    "src"
  ]
}
