{
  "name": "@clash/action-sdk",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "SDK for building Clash canvas actions \u2014 types and utilities for action authors",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./executable-failure": {
      "types": "./dist/executable-failure.d.ts",
      "import": "./dist/executable-failure.js",
      "default": "./dist/executable-failure.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.check.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@clash/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
