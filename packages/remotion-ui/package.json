{
  "name": "@clash/remotion-ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "description": "UI components for Remotion Fast video editor",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ci": "vitest run --passWithNoTests --coverage",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "remotion",
    "video-editor",
    "ui-components"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@remotion/player": "^4.0.0",
    "framer-motion": "^12.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remotion": "^4.0.0"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.31",
    "@clash/gui": "workspace:*",
    "@clash/shared-types": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@clash/remotion-components": "workspace:*",
    "@clash/remotion-core": "workspace:*",
    "@clash/remotion-effects": "workspace:*",
    "@use-gesture/react": "^10.3.1",
    "react-moveable": "^0.56.0"
  },
  "devDependencies": {
    "@remotion/player": "4.0.507",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/ui": "^1.3.1",
    "eslint": "^8.57.0",
    "framer-motion": "^12.23.24",
    "jsdom": "^29.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remotion": "4.0.507",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.3.1"
  }
}
