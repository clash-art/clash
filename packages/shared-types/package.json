{
  "name": "@clash/shared-types",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "description": "Shared type definitions for Clash (TypeScript + Python generation)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js",
      "default": "./dist/assets.js"
    },
    "./actions/asset-edit": {
      "types": "./dist/actions/asset-edit.d.ts",
      "import": "./dist/actions/asset-edit.js",
      "default": "./dist/actions/asset-edit.js"
    },
    "./timeline-library": {
      "types": "./dist/timeline-library.d.ts",
      "import": "./dist/timeline-library.js",
      "default": "./dist/timeline-library.js"
    },
    "./timeline-envelope": {
      "types": "./dist/timeline-envelope.d.ts",
      "import": "./dist/timeline-envelope.js",
      "default": "./dist/timeline-envelope.js"
    },
    "./model-output-contract": {
      "types": "./dist/model-output-contract.d.ts",
      "import": "./dist/model-output-contract.js",
      "default": "./dist/model-output-contract.js"
    },
    "./timeline-contract": {
      "types": "./dist/timeline-contract.d.ts",
      "import": "./dist/timeline-contract.js",
      "default": "./dist/timeline-contract.js"
    },
    "./executable-plugin": {
      "types": "./dist/executable-plugin.d.ts",
      "import": "./dist/executable-plugin.js",
      "default": "./dist/executable-plugin.js"
    },
    "./gpt-image-size": {
      "types": "./dist/gpt-image-size.d.ts",
      "import": "./dist/gpt-image-size.js",
      "default": "./dist/gpt-image-size.js"
    },
    "./director-code": {
      "types": "./dist/director-code.d.ts",
      "import": "./dist/director-code.js",
      "default": "./dist/director-code.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/assets.ts src/actions/asset-edit.ts src/timeline-library.ts src/timeline-contract.ts src/timeline-envelope.ts src/executable-plugin.ts src/model-output-contract.ts src/gpt-image-size.ts src/director-code.ts --format esm --dts --clean --target es2020",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:json-schema": "ts-node scripts/generate-json-schema.ts",
    "generate:python": "ts-node scripts/generate-python.ts",
    "generate:timeline-dsl-docs": "tsx scripts/generate-timeline-dsl-docs.ts",
    "prepack": "pnpm generate:timeline-dsl-docs"
  },
  "dependencies": {
    "@clash/shared-layout": "workspace:^",
    "loro-crdt": "^1.10.3",
    "yaml": "^2.6.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "files": [
    "dist",
    "python",
    "agents.json"
  ]
}
