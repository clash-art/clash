{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "..",
    "paths": {
      "@clash/shared-mcp": ["../shared-mcp/src/index.ts"],
      "@clash/shared-types": ["../shared-types/src/index.ts"],
      "@clash/shared-types/*": ["../shared-types/src/*.ts"],
      "@clash/shared-layout": ["../shared-layout/src/index.ts"]
    },
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"]
}
