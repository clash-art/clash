{
  "name": "@clash/director-ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "description": "Reusable React Three Fiber viewport and animation ruler for Clash Director Stage",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/public-api.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react --external react-dom --external three",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clash/director-core": "workspace:*",
    "@clash/shared-types": "workspace:*",
    "@clash/remotion-ui": "workspace:*",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.23.24",
    "typescript": "^5.9.3",
    "three": "^0.185.1"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.5.1",
    "vitest": "^4.1.0"
  }
}
