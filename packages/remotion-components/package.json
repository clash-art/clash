{
  "name": "@clash/remotion-components",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "description": "Remotion rendering components for Remotion Fast video editor",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ci": "vitest run --passWithNoTests --coverage",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "remotion",
    "video-rendering",
    "components"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remotion": "^4.0.0"
  },
  "dependencies": {
    "@clash/shared-types": "workspace:*",
    "@clash/remotion-core": "workspace:*",
    "@clash/remotion-effects": "workspace:*",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.507",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/ui": "^1.3.1",
    "eslint": "^8.57.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remotion": "4.0.507",
    "tsup": "^8.0.0",
    "vitest": "^1.3.1"
  }
}
