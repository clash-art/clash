{
  "name": "@clash/cli",
  "version": "0.1.0-beta.3",
  "private": true,
  "description": "Clash CLI — manage projects and canvas from your terminal",
  "bin": {
    "clash": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    }
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.plugin-esm.config.ts",
    "bundle:agents": "node scripts/bundle-agents.ts",
    "dev": "tsx --tsconfig tsconfig.dev.json src/index.ts",
    "typecheck": "tsc --noEmit --project tsconfig.dev.json",
    "clean": "rm -rf dist",
    "test": "node scripts/run-tests.ts",
    "test:e2e": "node --test e2e/canvas-add-refs.test.ts"
  },
  "dependencies": {
    "@clash/shared-runtime": "workspace:*",
    "@clash/shared-types": "workspace:*",
    "@clash/remotion-effects": "workspace:*",
    "commander": "^13.0.0",
    "esbuild": "^0.25.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@clash/shared-layout": "workspace:^",
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  },
  "files": [
    "dist"
  ]
}
