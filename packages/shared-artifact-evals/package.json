{
  "name": "@clash/artifact-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Artifact-first headless agent benchmark runner for Clash creative workflows",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "clash-artifact-bench": "./src/cli.ts"
  },
  "scripts": {
    "benchmark": "tsx --tsconfig tsconfig.dev.json src/cli.ts",
    "build": "tsup src/index.ts src/cli.ts src/pi-clash-extension.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.check.json"
  },
  "dependencies": {
    "@clash/asset-sdk": "workspace:*",
    "@clash/shared-runtime": "workspace:*",
    "@clash/shared-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@clash/gui": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
