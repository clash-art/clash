{
  "name": "@clash/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Clash SDK - typed clients for Clash local model runtimes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "tsup src/index.ts src/local-models.ts --format esm --clean --target node24 && tsc --emitDeclarationOnly --outDir dist",
    "dev": "tsup src/index.ts --format esm --watch --target node24",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
