{
  "name": "@clash/shared-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime endpoint helpers for hosted, local, and desktop Clash clients",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./local-paths": {
      "types": "./dist/local-paths.d.ts",
      "import": "./dist/local-paths.js",
      "default": "./dist/local-paths.js"
    },
    "./local-daemon": {
      "types": "./dist/local-daemon.d.ts",
      "import": "./dist/local-daemon.js",
      "default": "./dist/local-daemon.js"
    },
    "./observability": {
      "types": "./src/observability.ts",
      "import": "./dist/observability.js",
      "default": "./dist/observability.js"
    },
    "./generator-readback": {
      "types": "./src/generator-readback.ts",
      "import": "./src/generator-readback.ts",
      "default": "./dist/generator-readback.js"
    },
    "./generator-client": {
      "types": "./src/generator-client.ts",
      "import": "./src/generator-client.ts",
      "default": "./dist/generator-client.js"
    },
    "./document-client": {
      "types": "./src/document-client.ts",
      "import": "./src/document-client.ts",
      "default": "./dist/document-client.js"
    },
    "./durable-run-engine": {
      "types": "./src/durable-run-engine.ts",
      "import": "./src/durable-run-engine.ts",
      "default": "./dist/durable-run-engine.js"
    },
    "./project-host-client": {
      "types": "./dist/project-host-client.d.ts",
      "import": "./dist/project-host-client.js",
      "default": "./dist/project-host-client.js"
    },
    "./project-asset-client": {
      "types": "./dist/project-asset-client.d.ts",
      "import": "./dist/project-asset-client.js",
      "default": "./dist/project-asset-client.js"
    },
    "./minimax-h3": {
      "types": "./dist/minimax-h3.d.ts",
      "import": "./dist/minimax-h3.js",
      "default": "./dist/minimax-h3.js"
    },
    "./pika": {
      "types": "./dist/pika.d.ts",
      "import": "./dist/pika.js",
      "default": "./dist/pika.js"
    },
    "./logging": {
      "types": "./src/logging.ts",
      "import": "./src/logging.ts",
      "default": "./dist/logging.js"
    },
    "./log-reader": {
      "types": "./src/log-reader.ts",
      "import": "./src/log-reader.ts",
      "default": "./dist/log-reader.js"
    },
    "./project-cloud-sync": {
      "types": "./src/project-cloud-sync.ts",
      "import": "./src/project-cloud-sync.ts",
      "default": "./dist/project-cloud-sync.js"
    },
    "./minimax-executor": {
      "types": "./src/minimax-executor.ts",
      "import": "./src/minimax-executor.ts",
      "default": "./dist/minimax-executor.js"
    }
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.check.json"
  },
  "dependencies": {
    "@clash/action-sdk": "workspace:*",
    "@clash/asset-sdk": "workspace:*",
    "@clash/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.2",
    "esbuild": "0.25.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
