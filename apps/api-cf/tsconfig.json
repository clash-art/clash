{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [
      "@cloudflare/workers-types/2023-07-01",
      "@cloudflare/vitest-plugin/types"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@clash/shared-layout": ["../../packages/shared-layout/src/index.ts"],
      "@clash/asset-sdk/delivery": ["../../packages/asset-sdk/src/delivery.ts"],
      "@clash/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@clash/shared-types/*": ["../../packages/shared-types/src/*.ts"],
      "@clash/shared-runtime": ["../../packages/shared-runtime/src/index.ts"],
      "@clash/shared-runtime/*": ["../../packages/shared-runtime/src/*.ts"],
      "@clash/replica": ["../../packages/shared-replica/src/index.ts"],
      "@clash/replica/*": ["../../packages/shared-replica/src/*.ts"],
      "@clash/remotion-core": ["../../packages/remotion-core/src/index.ts"]
    },
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
