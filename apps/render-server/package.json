{
  "name": "@clash/render-server",
  "version": "0.1.0",
  "description": "Remotion video rendering service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/prebundle.ts --format esm --target node24 && node dist/prebundle.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.check.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@remotion/bundler": "4.0.507",
    "@remotion/renderer": "4.0.507",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.7.0",
    "react": "^19.2.5",
    "remotion": "4.0.507"
  },
  "devDependencies": {
    "@clash/remotion-components": "workspace:*",
    "@clash/remotion-core": "workspace:*",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
