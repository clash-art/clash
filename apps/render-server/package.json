{
  "name": "@clash/render-server",
  "version": "0.1.0",
  "description": "Remotion video rendering service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/telemetry.ts src/index.ts",
    "build": "tsup src/index.ts src/prebundle.ts src/telemetry.ts --format esm --target node24 && node dist/prebundle.js",
    "start": "node --import ./dist/telemetry.js dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.36.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@remotion/bundler": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.7.0",
    "import-in-the-middle": "^3.5.2",
    "react": "^19.2.5",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@clash/remotion-components": "workspace:*",
    "@clash/remotion-core": "workspace:*",
    "@clash/shared-runtime": "workspace:*",
    "@clash/shared-telemetry": "workspace:*",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.0"
  }
}
