# End-entity defaults for `openssl req -x509`.
# Ubuntu's /etc/ssl/openssl.cnf sets `x509_extensions = v3_ca`, so a one-shot
# self-signed fixture is marked CA:TRUE. uv's rustls verifier rejects that
# peer certificate as CaUsedAsEndEntity. This file keeps the fixture a leaf.
[ req ]
default_bits = 2048
prompt = no
distinguished_name = req_distinguished_name
x509_extensions = v3_leaf
[ req_distinguished_name ]
CN = localhost
[ v3_leaf ]
basicConstraints = CA:FALSE
subjectKeyIdentifier = hash
